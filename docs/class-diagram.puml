@startuml
' Flotix Platform Class Diagram
' Mirrors figure 4.7.1 of the project report (classes grouped by bounded context)
' with the members implemented in this repository.

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction
hide empty members

package "Identity, Profiles & Security Context" {
  abstract class User <<aggregate>> {
    +Id : Guid
    +Name : string
    +Email : EmailAddress
    +PasswordHash : string
    +RoleType : Role
    +{static} Create(SignUpCommand, string) : User
    +UpdateProfile(UpdateUserProfileCommand) : void
  }
  class Owner {
    +CompanyName : string?
  }
  class Driver {
    +LicenseNumber : string?
    +LicenseExpiration : DateOnly?
  }
  class Mechanic {
    +WorkshopName : string?
  }
  enum Role {
    Owner
    Driver
    Mechanic
  }
  class EmailAddress <<value object>> {
    +Value : string
  }
  User <|-- Owner
  User <|-- Driver
  User <|-- Mechanic
}

package "Vehicle & Fleet Management Context" {
  class Vehicle <<aggregate>> {
    +Id : Guid
    +OwnerId : Guid
    +DriverId : Guid?
    +LicensePlate : LicensePlate
    +VehicleType : string
    +CurrentMileage : decimal
    +Status : VehicleStatus
    +UpdateInformation(UpdateVehicleCommand) : void
  }
  class LicensePlate <<value object>> {
    +Value : string
  }
  enum VehicleStatus {
    Available : "Disponible"
    InMaintenance : "En mantenimiento"
    Inactive : "Inactivo"
  }
}

package "Fuel Control Context" {
  class FuelRecord <<aggregate>> {
    +Id : Guid
    +VehicleId : Guid
    +DriverId : Guid
    +Liters : decimal
    +Cost : decimal
    +MileageAtRefill : decimal
    +RecordedDate : DateTimeOffset
    +UpdateInformation(UpdateFuelRecordCommand) : void
  }
}

package "Maintenance Management Context" {
  class MaintenanceRequest <<aggregate>> {
    +Id : Guid
    +VehicleId : Guid
    +MechanicId : Guid
    +Description : string
    +EstimatedCost : decimal
    +Status : MaintenanceRequestStatus
    +RequestDate : DateTimeOffset
    +IsBudgetApproved : bool
    +IsCompleted : bool
    +SubmitQuote(decimal) : void
    +Approve() : void
    +Reject() : void
    +StartRepair() : void
    +Finish() : void
  }
  enum MaintenanceRequestStatus {
    Pending : "Pendiente"
    Quoted : "Presupuestado"
    Approved : "Aprobado"
    Rejected : "Rechazado"
    InRepair : "En reparación"
    Completed : "Completado"
  }
}

package "Incident Management Context" {
  class Incident <<aggregate>> {
    +Id : Guid
    +VehicleId : Guid
    +DriverId : Guid
    +Description : string
    +Status : IncidentStatus
    +ReportedDate : DateTimeOffset
    +UpdateInformation(UpdateIncidentCommand) : void
  }
  enum IncidentStatus {
    Open : "Abierto"
    InReview : "En revisión"
    Resolved : "Resuelto"
  }
}

package "Real-Time Monitoring Context" {
  class IotDevice <<aggregate>> {
    +Id : Guid
    +VehicleId : Guid
    +SerialNumber : SerialNumber
    +IsConnected : bool
    +Connect() : void
    +UpdateInformation(UpdateIotDeviceCommand) : void
  }
  class TelemetryData <<aggregate>> {
    +Id : Guid
    +DeviceId : Guid
    +Latitude : decimal
    +Longitude : decimal
    +Speed : decimal
    +RecordedAt : DateTimeOffset
    +{static} Validate(ReceiveTelemetryDataCommand) : void
  }
  class SerialNumber <<value object>> {
    +Value : string
  }
  class TelemetryDataProcessor <<IoT Telemetry Processor>>
}

package "Alerts & Notifications Context" {
  class Alert <<aggregate>> {
    +Id : Guid
    +VehicleId : Guid
    +AlertType : string
    +TriggerDate : DateTimeOffset
  }
  class Notification <<aggregate>> {
    +Id : Guid
    +UserId : Guid
    +AlertId : Guid?
    +Message : string
    +IsRead : bool
    +SentDate : DateTimeOffset
    +UpdateInformation(UpdateNotificationCommand) : void
  }
}

package "Digital Experience / IoT Commerce Context" {
  class IotOrder <<aggregate>> {
    +Id : Guid
    +OwnerId : Guid
    +Quantity : int
    +TotalAmount : decimal
    +Status : OrderStatus
    +OrderDate : DateTimeOffset
    +UpdateInformation(UpdateIotOrderCommand) : void
  }
  enum OrderStatus {
    PendingPayment : "Pendiente de pago"
    Preparing : "En preparación"
    Delivered : "Entregado"
    Cancelled : "Cancelado"
  }
}

package "Reporting & Analytics Context" {
  class Report <<aggregate>> {
    +Id : Guid
    +OwnerId : Guid
    +ReportType : ReportType
    +GeneratedDate : DateTimeOffset
    +FilterParams : string
  }
  class ReportLine <<value object>> {
    +VehicleId : Guid
    +LicensePlate : string
    +Records : int
    +Quantity : decimal
    +TotalCost : decimal
  }
  enum ReportType {
    FuelConsumption : "Reporte de consumo de combustible"
    MaintenanceCost : "Reporte de costos de mantenimiento"
  }
}

' Relations of the report diagram (foreign keys with ON DELETE RESTRICT)
Owner "1" --> "0..*" Vehicle : manages >
Driver "0..1" --> "0..*" Vehicle : assigned to >
Driver "1" --> "0..*" FuelRecord : registers >
Driver "1" --> "0..*" Incident : reports >
Mechanic "1" --> "0..*" MaintenanceRequest : attends >
Owner "1" --> "0..*" IotOrder : places >
Owner "1" --> "0..*" Report : views >
User "1" --> "0..*" Notification : receives >
Vehicle "1" --> "0..*" FuelRecord : requires >
Vehicle "1" --> "0..*" MaintenanceRequest : requires >
Vehicle "1" --> "0..*" Incident : has >
Vehicle "1" --> "0..1" IotDevice : equipped with >
Vehicle "1" --> "0..*" Alert : triggers >
IotDevice "1" --> "0..*" TelemetryData : transmits >
Alert "1" --> "0..*" Notification : generates >
Report ..> ReportLine : consolidates >
TelemetryDataProcessor ..> TelemetryData : stores >
TelemetryDataProcessor ..> IotDevice : connects >
@enduml
