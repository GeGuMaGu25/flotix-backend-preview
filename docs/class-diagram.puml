@startuml
' Flotix Platform Class Diagram (bounded contexts, aggregates and services)

skinparam classAttributeIconSize 0
left to right direction

package "Shared" {
  interface IAuditableEntity { +DateTimeOffset? CreatedAt
    +DateTimeOffset? UpdatedAt }
  interface "IBaseRepository<TEntity>" as IBaseRepository {
    +AddAsync(TEntity, CancellationToken) : Task
    +FindByIdAsync(int, CancellationToken) : Task<TEntity?>
    +Update(TEntity) : void
    +Remove(TEntity) : void
    +ListAsync(CancellationToken) : Task<IEnumerable<TEntity>>
  }
  interface IUnitOfWork { +CompleteAsync(CancellationToken) : Task }
  class "Result<TValue, TError>" as Result <<pattern>>
  class AppDbContext
  class AuditableEntityInterceptor
}

package "IAM" as IAMContext <<Identity, Profiles & Security>> {
  class EmailAddress <<value-object>> { +string Value }
  enum Role {
    Owner
    Driver
    Mechanic
  }
  class User <<aggregate>> {
    +int Id
    +EmailAddress Email
    +string PasswordHash
    +Role Role
    +string FullName
    +string? LicenseNumber
    +DateOnly? LicenseExpiry
    +string? CompanyName
    +string? WorkshopName
    +UpdateProfile(UpdateUserProfileCommand)
  }
  User ..|> IAuditableEntity
  interface IUserRepository
  IUserRepository --|> IBaseRepository
  class UserCommandService
  class UserQueryService
  UserCommandService --> IUserRepository
  UserCommandService --> IUnitOfWork
  UserQueryService --> IUserRepository
  User --> EmailAddress
  User --> Role
  class AuthenticationController
  class UsersController
  AuthenticationController --> UserCommandService
  UsersController --> UserQueryService
  class RequestAuthorizationMiddleware <<middleware>>
  RequestAuthorizationMiddleware --> UserQueryService
  interface IHashingService
  interface ITokenService
  UserCommandService --> IHashingService
  UserCommandService --> ITokenService
}

package "Fleet" as FleetContext <<Vehicle & Fleet Management>> {
  class LicensePlate <<value-object>> { +string Value }
  enum VehicleStatus {
    Available
    InMaintenance
    Inactive
  }
  class FleetPreferences <<aggregate>> {
    +int Id
    +int SpeedLimitKmh
    +int MaintenanceIntervalKm
    +int FuelAnomalyDropPct
    +UpdateInformation(UpdateFleetPreferencesCommand)
  }
  FleetPreferences ..|> IAuditableEntity
  interface IFleetPreferencesRepository
  IFleetPreferencesRepository --|> IBaseRepository
  class FleetPreferencesCommandService
  class FleetPreferencesQueryService
  FleetPreferencesCommandService --> IFleetPreferencesRepository
  FleetPreferencesCommandService --> IUnitOfWork
  FleetPreferencesQueryService --> IFleetPreferencesRepository
  class Vehicle <<aggregate>> {
    +int Id
    +int OwnerId
    +int? DriverId
    +LicensePlate Plate
    +string VehicleType
    +int CurrentMileage
    +VehicleStatus Status
    +UpdateInformation(UpdateVehicleCommand)
  }
  Vehicle ..|> IAuditableEntity
  interface IVehicleRepository
  IVehicleRepository --|> IBaseRepository
  class VehicleCommandService
  class VehicleQueryService
  VehicleCommandService --> IVehicleRepository
  VehicleCommandService --> IUnitOfWork
  VehicleQueryService --> IVehicleRepository
  class VehiclesController
  VehiclesController --> VehicleCommandService
  Vehicle --> LicensePlate
  Vehicle --> VehicleStatus
  class FleetPreferencesController
  FleetPreferencesController --> FleetPreferencesCommandService
}

package "Fuel" as FuelContext <<Fuel Control>> {
  class FuelRecord <<aggregate>> {
    +int Id
    +int VehicleId
    +int DriverId
    +decimal Liters
    +decimal TotalCost
    +int MileageAtRefuel
    +DateOnly Date
    +UpdateInformation(UpdateFuelRecordCommand)
  }
  FuelRecord ..|> IAuditableEntity
  interface IFuelRecordRepository
  IFuelRecordRepository --|> IBaseRepository
  class FuelRecordCommandService
  class FuelRecordQueryService
  FuelRecordCommandService --> IFuelRecordRepository
  FuelRecordCommandService --> IUnitOfWork
  FuelRecordQueryService --> IFuelRecordRepository
  class FuelRecordsController
  FuelRecordsController --> FuelRecordCommandService
}

package "Maintenance" as MaintenanceContext <<Maintenance Management>> {
  class PhoneNumber <<value-object>> { +string Value }
  enum MaintenanceRequestStatus {
    Pending
    Quoted
    Approved
    Rejected
    InRepair
    Completed
  }
  class Workshop <<aggregate>> {
    +int Id
    +int MechanicId
    +string City
    +string District
    +string Address
    +PhoneNumber Phone
    +decimal Rating
    +List<string> Tags
    +UpdateInformation(UpdateWorkshopCommand)
  }
  Workshop ..|> IAuditableEntity
  interface IWorkshopRepository
  IWorkshopRepository --|> IBaseRepository
  class WorkshopCommandService
  class WorkshopQueryService
  WorkshopCommandService --> IWorkshopRepository
  WorkshopCommandService --> IUnitOfWork
  WorkshopQueryService --> IWorkshopRepository
  class MaintenanceRequest <<aggregate>> {
    +int Id
    +int VehicleId
    +int? MechanicId
    +string FaultDescription
    +decimal EstimatedCost
    +MaintenanceRequestStatus Status
    +UpdateInformation(UpdateMaintenanceRequestCommand)
  }
  MaintenanceRequest ..|> IAuditableEntity
  interface IMaintenanceRequestRepository
  IMaintenanceRequestRepository --|> IBaseRepository
  class MaintenanceRequestCommandService
  class MaintenanceRequestQueryService
  MaintenanceRequestCommandService --> IMaintenanceRequestRepository
  MaintenanceRequestCommandService --> IUnitOfWork
  MaintenanceRequestQueryService --> IMaintenanceRequestRepository
  class WorkshopsController
  WorkshopsController --> WorkshopCommandService
  Workshop --> PhoneNumber
  class MaintenanceRequestsController
  MaintenanceRequestsController --> MaintenanceRequestCommandService
  MaintenanceRequest --> MaintenanceRequestStatus
}

package "Incidents" as IncidentsContext <<Incident Management>> {
  enum IncidentStatus {
    Open
    InReview
    Resolved
  }
  class Incident <<aggregate>> {
    +int Id
    +int VehicleId
    +int DriverId
    +string Description
    +IncidentStatus Status
    +DateTimeOffset ReportedAt
    +UpdateInformation(UpdateIncidentCommand)
  }
  Incident ..|> IAuditableEntity
  interface IIncidentRepository
  IIncidentRepository --|> IBaseRepository
  class IncidentCommandService
  class IncidentQueryService
  IncidentCommandService --> IIncidentRepository
  IncidentCommandService --> IUnitOfWork
  IncidentQueryService --> IIncidentRepository
  class IncidentsController
  IncidentsController --> IncidentCommandService
  Incident --> IncidentStatus
}

package "Monitoring" as MonitoringContext <<Real-Time Monitoring / Fleet Tracking>> {
  class SerialNumber <<value-object>> { +string Value }
  enum ConnectionStatus {
    Connected
    Disconnected
  }
  class IotDevice <<aggregate>> {
    +int Id
    +int VehicleId
    +SerialNumber SerialNumber
    +ConnectionStatus ConnectionStatus
    +UpdateInformation(UpdateIotDeviceCommand)
  }
  IotDevice ..|> IAuditableEntity
  interface IIotDeviceRepository
  IIotDeviceRepository --|> IBaseRepository
  class IotDeviceCommandService
  class IotDeviceQueryService
  IotDeviceCommandService --> IIotDeviceRepository
  IotDeviceCommandService --> IUnitOfWork
  IotDeviceQueryService --> IIotDeviceRepository
  class TelemetryRecord <<aggregate>> {
    +int Id
    +int DeviceId
    +double Latitude
    +double Longitude
    +int Speed
    +DateTimeOffset Timestamp
  }
  TelemetryRecord ..|> IAuditableEntity
  interface ITelemetryRecordRepository
  ITelemetryRecordRepository --|> IBaseRepository
  class TelemetryRecordCommandService
  class TelemetryRecordQueryService
  TelemetryRecordCommandService --> ITelemetryRecordRepository
  TelemetryRecordCommandService --> IUnitOfWork
  TelemetryRecordQueryService --> ITelemetryRecordRepository
  class IotDevicesController
  IotDevicesController --> IotDeviceCommandService
  IotDevice --> SerialNumber
  IotDevice --> ConnectionStatus
  class TelemetryDataController
  TelemetryDataController --> TelemetryRecordCommandService
  class MonitoringHub <<hub>>
}

package "Notifications" as NotificationsContext <<Alerts & Notifications>> {
  class Alert <<aggregate>> {
    +int Id
    +int VehicleId
    +string AlertType
    +DateTimeOffset ActivatedAt
  }
  Alert ..|> IAuditableEntity
  interface IAlertRepository
  IAlertRepository --|> IBaseRepository
  class AlertCommandService
  class AlertQueryService
  AlertCommandService --> IAlertRepository
  AlertCommandService --> IUnitOfWork
  AlertQueryService --> IAlertRepository
  class Notification <<aggregate>> {
    +int Id
    +int UserId
    +int? AlertId
    +string Message
    +bool IsRead
    +DateTimeOffset SentAt
    +UpdateInformation(UpdateNotificationCommand)
  }
  Notification ..|> IAuditableEntity
  interface INotificationRepository
  INotificationRepository --|> IBaseRepository
  class NotificationCommandService
  class NotificationQueryService
  NotificationCommandService --> INotificationRepository
  NotificationCommandService --> IUnitOfWork
  NotificationQueryService --> INotificationRepository
  class NotificationPreference <<aggregate>> {
    +int Id
    +int UserId
    +bool Maintenance
    +bool Speed
    +bool Incidents
    +UpdateInformation(UpdateNotificationPreferenceCommand)
  }
  NotificationPreference ..|> IAuditableEntity
  interface INotificationPreferenceRepository
  INotificationPreferenceRepository --|> IBaseRepository
  class NotificationPreferenceCommandService
  class NotificationPreferenceQueryService
  NotificationPreferenceCommandService --> INotificationPreferenceRepository
  NotificationPreferenceCommandService --> IUnitOfWork
  NotificationPreferenceQueryService --> INotificationPreferenceRepository
  class AlertsController
  AlertsController --> AlertCommandService
  class NotificationsController
  NotificationsController --> NotificationCommandService
  class NotificationPreferencesController
  NotificationPreferencesController --> NotificationPreferenceCommandService
  class NotificationsHub <<hub>>
}

package "Commerce" as CommerceContext <<Digital Experience / IoT Commerce>> {
  class Sku <<value-object>> { +string Value }
  enum OrderStatus {
    PendingPayment
    Preparing
    Delivered
    Cancelled
  }
  class IotCatalogItem <<aggregate>> {
    +int Id
    +Sku Sku
    +string Name
    +decimal UnitPrice
    +string IconName
    +UpdateInformation(UpdateIotCatalogItemCommand)
  }
  IotCatalogItem ..|> IAuditableEntity
  interface IIotCatalogItemRepository
  IIotCatalogItemRepository --|> IBaseRepository
  class IotCatalogItemCommandService
  class IotCatalogItemQueryService
  IotCatalogItemCommandService --> IIotCatalogItemRepository
  IotCatalogItemCommandService --> IUnitOfWork
  IotCatalogItemQueryService --> IIotCatalogItemRepository
  class IotOrder <<aggregate>> {
    +int Id
    +int OwnerId
    +Sku Sku
    +int DeviceQuantity
    +decimal TotalAmount
    +OrderStatus Status
    +DateOnly OrderDate
    +UpdateInformation(UpdateIotOrderCommand)
  }
  IotOrder ..|> IAuditableEntity
  interface IIotOrderRepository
  IIotOrderRepository --|> IBaseRepository
  class IotOrderCommandService
  class IotOrderQueryService
  IotOrderCommandService --> IIotOrderRepository
  IotOrderCommandService --> IUnitOfWork
  IotOrderQueryService --> IIotOrderRepository
  class IotCatalogController
  IotCatalogController --> IotCatalogItemCommandService
  IotCatalogItem --> Sku
  class IotOrdersController
  IotOrdersController --> IotOrderCommandService
  IotOrder --> Sku
  IotOrder --> OrderStatus
  IotOrderCommandService --> IIotCatalogItemRepository : prices orders
}

package "Analytics" as AnalyticsContext <<Reporting & Analytics>> {
  class Report <<aggregate>> {
    +int Id
    +int OwnerId
    +string ReportType
    +Dictionary<string, string> FilterParams
    +DateTimeOffset GeneratedAt
  }
  Report ..|> IAuditableEntity
  interface IReportRepository
  IReportRepository --|> IBaseRepository
  class ReportCommandService
  class ReportQueryService
  ReportCommandService --> IReportRepository
  ReportCommandService --> IUnitOfWork
  ReportQueryService --> IReportRepository
  class ReportsController
  ReportsController --> ReportCommandService
}

@enduml
